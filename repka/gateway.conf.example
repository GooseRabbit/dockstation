# DockStation C++ Gateway: local read-only API.
# API bind address is fixed in code to 127.0.0.1.
api_port=8080
log_level=info
log_stderr=true

# Optional Repka<->ESP32 controller link. Keep all three settings commented
# until the exact UART device and both controller protocol IDs are known.
# Credentials are provisioned separately at /etc/dockstation/credentials/repka-esp32.psk.
# controller_uart_device=/dev/serial0
# controller_local_id=repka-01
# controller_peer_id=esp32-01
#
# Optional authenticated subsystem-event ingestion. These values are not the
# PSK identity and do not create a trusted registration. The source must first
# be provisioned locally in SQLite for this Station ID and the PSK identity.
# Leave both commented until the station identity/source registration exists.
# station_id=station-01
# controller_source=esp32.main
