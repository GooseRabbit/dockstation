# Physical prototype acceptance: ESP32-D0WD-V3 revision 3.1 with 4 MB SPI Flash.
# Keep the build and generated flasher arguments aligned with the measured device.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Arduino Core is only needed by the Adafruit DHT component; keep ESP-IDF app_main().
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_FREERTOS_HZ=1000

# UART0 is the board USB-UART console and prototype telemetry output.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# ControllerLink requires the TLS 1.3 server API and keying-material exporter.
CONFIG_MBEDTLS_TLS_SERVER_ONLY=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=n
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_KEYING_MATERIAL_EXPORT=y

# Limit the negotiated profile to the algorithms already used by ControllerLink.
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_GCM_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# Session resumption is intentionally not part of the initial link profile.
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
